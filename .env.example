# Download the official native Stockfish 19 executable and use its absolute path.
# Quotes work for paths containing spaces. On Windows, use forward slashes.
# STOCKFISH_PATH="C:/chess/stockfish/stockfish-windows-x86-64.exe"
# STOCKFISH_PATH="/Users/me/chess/stockfish/stockfish-macos-m1-apple-silicon"
# STOCKFISH_PATH="/home/me/chess/stockfish/stockfish-ubuntu-x86-64"
# If omitted, searches PATH for `stockfish`.

# Optional. Defaults: half physical cores (1–4), available RAM / 16 (16–256 MiB).
# STOCKFISH_THREADS=2
# STOCKFISH_HASH_MB=128

# Only override if changing the frontend port; comma-separated exact origins.
# ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000,http://localhost:8000
